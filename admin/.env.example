# Copy to .env and fill in. Never commit real secrets.
# Base URL of the shared FastAPI backend (no trailing slash).
# Leave empty in development — the Vite dev server proxies /api to localhost:8000.
VITE_API_URL=

# Dev-only: where the Vite proxy forwards /api (defaults to http://localhost:8000)
# ADMIN_API_PROXY=http://localhost:8000
