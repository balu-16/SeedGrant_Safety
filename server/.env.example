# Copy to .env and fill in. Never commit real secrets.
APP_NAME="Smart Safety Tag API"
ENV=development
# Supabase Postgres (Session Pooler recommended for asyncpg). Example:
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=
DB_SSLMODE=require
DB_POOL_MIN=1
DB_POOL_MAX=10

JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# JSON list (parsed before validators run), or * for development
CORS_ORIGINS=["*"]
LOG_LEVEL=INFO

# Set TESTING=true only under test runners; it relaxes startup checks.
TESTING=false

# Push notifications: "mock" (log-only) or "fcm" (Firebase Cloud Messaging v1)
PUSH_PROVIDER=mock
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=./fcm-service-account.json
# FCM_DRY_RUN=true validates messages against FCM without delivering
FCM_DRY_RUN=false

# Render API access (deployments). Fill in locally, never commit.
RENDER_API_KEY=
